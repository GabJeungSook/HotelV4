includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Read the models' casts() method, so Money and enum casts type the attributes.
    parseModelCastsMethod: true
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
